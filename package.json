{
	"name": "modai",
	"version": "3.3.0",
	"description": "This is an LLM plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"format": "prettier --check \"**/*.{ts,mts,css,json,md}\"",
		"format:fix": "prettier --write \"**/*.{ts,mts,css,json,md}\"",
		"knip": "knip",
		"test": "vitest run",
		"test:watch": "vitest",
		"check-all": "npm run lint && npm run format && npm run knip && npm run test"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@eslint/js": "10.0.1",
		"@types/node": "^26.6.6",
		"esbuild": "0.28.2",
		"eslint": "10.14.0",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.14.0",
		"jiti": "^2.7.0",
		"knip": "6.44.1",
		"prettier": "3.9.10",
		"tslib": "2.9.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"diff": "^9.0.0",
		"obsidian": "latest"
	}
}
