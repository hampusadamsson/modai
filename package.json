{
	"name": "modai",
	"version": "3.1.1",
	"description": "This is an LLM plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"format": "prettier --check \"**/*.{ts,mts,css,json,md}\"",
		"format:fix": "prettier --write \"**/*.{ts,mts,css,json,md}\"",
		"knip": "knip",
		"test": "vitest run",
		"test:watch": "vitest",
		"check-all": "npm run lint && npm run format && npm run knip && npm run test"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "9.39.5",
		"@types/node": "^25.9.8",
		"esbuild": "0.28.2",
		"eslint": "10.11.0",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.12.0",
		"jiti": "^2.7.0",
		"knip": "6.37.0",
		"prettier": "3.9.8",
		"tslib": "2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"diff": "^9.0.0",
		"obsidian": "latest"
	}
}
